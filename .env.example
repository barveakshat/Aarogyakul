# =========================================================================
# AarogyaKul Global Environment Template (.env.example)
# =========================================================================

# --- Database (Supabase) ---
DATABASE_URL=jdbc:postgresql://db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your-secure-password

# --- Local Docker Postgres (Optional) ---
# Only required if starting with: docker compose --profile local up
POSTGRES_PASSWORD=your-local-postgres-password

# --- Security / Auth ---
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRY_HOURS=24
SERVER_CORS_ORIGIN=http://localhost:5173

# --- Storage Configuration (Local or S3) ---
STORAGE_MODE=local
# AWS S3 keys are only required if STORAGE_MODE=s3
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET_NAME=aarogyakul-documents
AWS_REGION=ap-south-1

# --- AI Configuration (HuggingFace) ---
HUGGINGFACE_API_URL=https://router.huggingface.co/v1/chat/completions
HUGGINGFACE_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxx
LLAMA_MODEL_NAME=meta-llama/Llama-3.1-8B-Instruct

# --- Frontend (Vite) ---
# Optional. Leave empty for local development and same-origin deployments.
# Vite proxies /api to http://localhost:8080 during local development.
VITE_API_BASE_URL=
